def _p2_layout(P, F, s):
    """Draws (or, when P.dry, measures) page 2. Returns (bottom of description table, top of weblinks)."""
    y = H - 66
    y -= P.para(MX, y, CW, "Major Changes w.r.t previous month \u2013", FONT_BOLD, 10.5) + 8
    LWd = 346.0
    rows = [[nm, "", pct(v)] for nm, v in F.added] + [["", nm, pct(v)] for nm, v in F.reduced]
    if not rows:
        rows = [[Cell("No major changes in holdings this month", span=3)]]
    hL = table(P, MX, y, [128, 128, 90],
               [["Name of Securities Added/ Increased", "Name of securities deleted/reduced", "Total Weightage in %"]],
               rows, s, ["l", "l", "c"], title="(Top 10 changes in Holding) in portfolio of the scheme")
    xr = MX + LWd + 12
    wr = W - MX - xr
    cws = [wr - 120, 60, 60]
    er = [[k, pct(F.ter[k][1]) if F.ter[k][1] is not None else "NA", pct(F.ter[k][0])] for k in ("Direct", "Regular")]
    hR1 = table(P, xr, y, cws, [["Change in", "Previous Month", "Current Month"]], er, s,
                ["l", "c", "c"], title="Changes in Base Expense Ratio of the scheme")
    hR2 = table(P, xr, y - hR1 - 10, cws, [["Change in", "Previous Month", "Current Month"]],
                [["Scheme Riskometer", F.rm_prev or "NA", F.rm_scheme]], s, ["l", "c", "c"],
                title="Changes in Risk-o-Meter of scheme")
    y -= max(hL, hR1 + 10 + hR2) + 14

    desc = [("Standard Deviation (%)", "common.rm.std"), ("Beta", "common.rm.beta"),
            ("Sharpe Ratio", "common.rm.sharpe"), ("Information Ratio", "common.rm.info")]
    d_rows = [[str(i), n, F.t[k]] for i, (n, k) in enumerate(desc, 1)]
    hD = table(P, MX, y, [40, 170, CW - 210], [["Sr. No.", "Quantitative Measures/Risk Measures",
                                                "Brief description/ Inference of the Quantitative measure"]],
               d_rows, s, ["c", "l", "l"], title="Description/Inference of the Quantitative/Risk Measures")

    wrows = []
    for i, (nm, d_, url) in enumerate(F.web, 1):
        if i == 4:
            im = prepare_image(F.img_qr, 60, 60, "qr") if F.img_qr else None
            wrows.append([str(i), Cell("", img=im, img_h=54.0, link=url), d_])
        else:
            wrows.append([str(i), Cell(nm, link=url, underline=bool(url)), d_])
    args = ([40, 170, CW - 210], [["Sr. No.", "Links", "Description"]], wrows, s + 0.3, ["c", "l", "l"])
    was = P.dry
    P.dry = True
    hW = table(P, MX, 0, *args, title="Important Weblinks", pady=3.4)
    P.dry = was
    wtop = BOTTOM + 6 + hW
    table(P, MX, wtop, *args, title="Important Weblinks", pady=3.4)
    return y - hD, wtop


def page2(P, F, page_no):
    P.fill_page()
    draw_header(P, F)
    for k in range(0, 21):
        s = 7.8 - 0.1 * k
        P.dry = True
        bottom, wtop = _p2_layout(P, F, s)
        P.dry = False
        if bottom >= wtop + 8:
            break
    else:
        warn("Page 2: the changes-in-holdings list is too long to fit; shorten the names")
    _p2_layout(P, F, s)
    draw_footer(P, F, page_no)


