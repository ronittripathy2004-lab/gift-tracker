def find_logo(cli_logo):
    cands = []
    if cli_logo:
        cands.append(Path(cli_logo))
    if LOGO_PATH:
        cands.append(Path(LOGO_PATH))
    for ext in (".png", ".jpg", ".jpeg"):
        cands += [BASE_DIR / f"logo{ext}", BASE_DIR / "Logo" / f"logo{ext}", BASE_DIR / "logo" / f"logo{ext}",
                  RISK_DIR / f"logo{ext}", QR_DIR / f"logo{ext}"]
    for p in cands:
        if p.is_file():
            return p
    return None


def load_funds():
    if not EXCEL_PATH.is_file():
        sys.exit(f"Workbook not found: {EXCEL_PATH}")
    wb = openpyxl.load_workbook(EXCEL_PATH, data_only=True)
    qr_idx, risk_idx = index_dir(QR_DIR), index_dir(RISK_DIR)
    if not QR_DIR.is_dir():
        err(f"QR folder not found: {QR_DIR}")
    if not RISK_DIR.is_dir():
        err(f"Riskometer folder not found: {RISK_DIR}")
    funds = []
    for ws in wb.worksheets:
        if ws.title.startswith("_") or ws.sheet_state != "visible":
            continue
        _CTX[0] = ws.title
        try:
            funds.append(parse_fund(ws, qr_idx, risk_idx))
        except Exception as e:  # never let one bad sheet hide the others' problems
            err(f"could not read sheet: {type(e).__name__}: {e}")
    _CTX[0] = "-"
    if not funds:
        err("No fund sheets found (sheets starting with '_' are ignored)")
    # duplicate-content detector
    seen = {}
    for F in funds:
        sig = (tuple(F.nav[:1]), F.about, tuple(F.top))
        if sig in seen:
            ISSUES.append(("WARN", F.sheet, f"content is identical to sheet '{seen[sig]}' (unedited copy?)"))
        seen.setdefault(sig, F.sheet)
    return funds


def build_pdf(funds, out: Path, start_page: int):
    tmp = out.with_suffix(".tmp.pdf")
    c = canvas.Canvas(str(tmp), pagesize=A4, pageCompression=1)
    f0 = funds[0]
    c.setTitle(f"{f0.amc or 'Fund'} - Factsheets - {f0.month}")
    c.setAuthor(f0.amc or "")
    c.setSubject(f"Mutual fund factsheets, {f0.month}")
    c.setCreator("generate_factsheets.py")
    P = Painter(c)
    n = start_page
    for i, F in enumerate(funds):
        _CTX[0] = F.sheet
        key = f"fund{i}"
        c.bookmarkPage(key)
        c.addOutlineEntry(re.sub(r"[$\u00a3#@^]+$", "", F.name), key, 0)
        for fn in (page1, page2, page3):
            fn(P, F, n)
            c.showPage()
            n += 1
        print(f"  \u2713 {F.name}  (pages {n - 3}-{n - 1})")
    c.save()
    os.replace(tmp, out)
    _CTX[0] = "-"


def main():
    global EXCEL_PATH, QR_DIR, RISK_DIR, LOGO_FILE, OUTPUT_PDF
    ap = argparse.ArgumentParser(description="Build the combined factsheet PDF from the Excel data workbook.")
    ap.add_argument("--excel", type=Path, default=EXCEL_PATH)
    ap.add_argument("--qr-dir", type=Path, default=QR_DIR)
    ap.add_argument("--risk-dir", type=Path, default=RISK_DIR)
    ap.add_argument("--logo", type=Path, default=None)
    ap.add_argument("--out", type=Path, default=OUTPUT_PDF)
    ap.add_argument("--start-page", type=int, default=START_PAGE)
    ap.add_argument("--check", action="store_true", help="validate the data and images only; write no PDF")
    ap.add_argument("--strict", action="store_true", help="treat warnings as errors")
    a = ap.parse_args()
    EXCEL_PATH, QR_DIR, RISK_DIR, OUTPUT_PDF = a.excel, a.qr_dir, a.risk_dir, a.out

    register_fonts()
    LOGO_FILE = find_logo(a.logo)
    print(f"Logo : {LOGO_FILE or 'not found - AMC name will be printed instead'}")
    if LOGO_FILE is None:
        warn("logo not found (looked for logo.png/jpg in the Factsheet folder); AMC name printed instead")
    funds = load_funds()
    if _MISSING:
        warn("characters missing from the font (will print as boxes): " + " ".join(sorted(_MISSING)))

    errors = [i for i in ISSUES if i[0] == "ERROR"]
    if not errors and not a.check:
        print(f"Building {len(funds)} fund(s) ...")
        build_pdf(funds, a.out, a.start_page)
        if _MISSING:
            ISSUES.append(("WARN", "-", "characters missing from the font: " + " ".join(sorted(_MISSING))))
    seen = set()
    for lvl, ctx, msg in ISSUES:
        if (lvl, ctx, msg) in seen:
            continue
        seen.add((lvl, ctx, msg))
        print(f"[{lvl}] {ctx}: {msg}")
    errors = [i for i in ISSUES if i[0] == "ERROR"]
    warns = [i for i in ISSUES if i[0] == "WARN"]
    if errors or (a.strict and warns):
        print(f"\nNOT BUILT: {len(errors)} error(s), {len(warns)} warning(s). Fix the items above and run again.")
        sys.exit(1)
    if a.check:
        print(f"\nCheck passed: {len(funds)} fund(s), {len(warns)} warning(s).")
    else:
        print(f"\nDone -> {a.out}  ({len(funds) * 3} pages, {len(warns)} warning(s))")


if __name__ == "__main__":
    main()
