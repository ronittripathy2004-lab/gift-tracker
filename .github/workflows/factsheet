class Cell:
    def __init__(self, text="", bold=None, align=None, link=None, img=None, img_h=0.0,
                 span=1, underline=False):
        self.text, self.bold, self.align, self.link = text, bold, align, link
        self.img, self.img_h, self.span, self.underline = img, img_h, span, underline


def table(P, x, top, widths, header, rows, s, aligns=None, title=None, padx=3.0, pady=2.3,
          bold_first_col=False):
    w = sum(widths)
    lead = s * 1.22
    y = top
    aligns = aligns or ["l"] * len(widths)
    if title:
        y -= bar(P, x, y, w, title, s)
    top_body = y
    items = [(r, True) for r in header] + [(r, False) for r in rows]
    for r, is_h in items:
        cells, col = [], 0
        for cell in r:
            cell = cell if isinstance(cell, Cell) else Cell(str(cell))
            cells.append((cell, col, cell.span))
            col += cell.span
        # height
        rh = 0.0
        prepared = []
        for cell, c0, sp in cells:
            cw = sum(widths[c0:c0 + sp])
            bold = cell.bold if cell.bold is not None else (is_h or (bold_first_col and c0 == 0))
            font = FONT_BOLD if bold else FONT_REG
            lines = wrap(cell.text, font, s, cw - 2 * padx) if cell.text else []
            hh = len(lines) * lead + 2 * pady if lines else 0
            if cell.img is not None:
                hh = max(hh, cell.img_h + 2 * pady)
            rh = max(rh, hh)
            prepared.append((cell, c0, sp, cw, font, lines))
        rh = max(rh, lead + 2 * pady)
        if not P.dry:
            for cell, c0, sp, cw, font, lines in prepared:
                cx = x + sum(widths[:c0])
                al = cell.align or ("c" if is_h else aligns[c0])
                block = len(lines) * lead
                y0 = y - (rh - block) / 2
                for i, ln in enumerate(lines):
                    base = y0 - i * lead - lead / 2 - s * 0.35
                    if al == "l":
                        P.txt(cx + padx, base, ln, font, s)
                        lx0, lx1 = cx + padx, cx + padx + rw(ln, font, s)
                    elif al == "c":
                        P.txt(cx + cw / 2, base, ln, font, s, "c")
                        lx0, lx1 = cx + cw / 2 - rw(ln, font, s) / 2, cx + cw / 2 + rw(ln, font, s) / 2
                    else:
                        P.txt(cx + cw - padx, base, ln, font, s, "r")
                        lx0, lx1 = cx + cw - padx - rw(ln, font, s), cx + cw - padx
                    if cell.underline and ln:
                        P.line(lx0, base - 1.6, lx1, base - 1.6, lw=0.5)
                if cell.img is not None:
                    im, aspect = cell.img
                    bw, bh = cw - 2 * padx, cell.img_h
                    dw, dh = (bh * aspect, bh) if bh * aspect <= bw else (bw, bw / aspect)
                    P.image(im, cx + (cw - dw) / 2, y - (rh - dh) / 2 - dh, dw, dh)
                if cell.link:
                    P.link(cell.link, cx, y, cw, rh)
                if c0 > 0:
                    P.line(cx, y, cx, y - rh, 0.4)
            P.line(x, y - rh, x + w, y - rh, 0.9 if is_h else 0.4)
        y -= rh
    P.rect(x, top_body, w, top_body - y, fill=None, stroke=NAVY, lw=0.8)
    return top - y


