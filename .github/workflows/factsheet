# =============================================================================
# Text engine  (wrapping, superscript footnote marks, black text)
# =============================================================================
SUP = 0.58
_SUP_RE = re.compile(r"(?<=[^\s$\u00a3#@^])([$\u00a3#@^]+)")


def segs(text):
    out, pos = [], 0
    for m in _SUP_RE.finditer(text):
        if m.start() > pos:
            out.append((text[pos:m.start()], False))
        out.append((m.group(1), True))
        pos = m.end()
    if pos < len(text):
        out.append((text[pos:], False))
    return out or [("", False)]


def _check_glyphs(text):
    for ch in text:
        if ord(ch) not in _GLYPHS and ch not in "\n" and ord(ch) > 31:
            _MISSING.add(ch)


def rw(text, font, size):
    _check_glyphs(text)
    return sum(pdfmetrics.stringWidth(t, font, size * (SUP if sp else 1)) for t, sp in segs(text))


def wrap(text, font, size, width, first_indent=0.0):
    out: list[str] = []
    width = max(width, 12)

    def avail():
        return max(width - (first_indent if not out else 0), 12)

    for para in str(text).split("\n"):
        cur = ""
        for wd in para.split():
            while rw(wd, font, size) > avail():
                if cur:
                    out.append(cur)
                    cur = ""
                    continue
                k = len(wd)
                while k > 1 and rw(wd[:k], font, size) > avail():
                    k -= 1
                out.append(wd[:k])
                wd = wd[k:]
            trial = f"{cur} {wd}" if cur else wd
            if rw(trial, font, size) <= avail():
                cur = trial
            else:
                out.append(cur)
                cur = wd
        out.append(cur)
    return out or [""]


class Painter:
    """Thin wrapper over the canvas.  When .dry is True nothing is drawn, so every
    builder can first *measure* itself, then draw."""

    def __init__(self, c):
        self.c = c
        self.dry = False

    # -- primitives ---------------------------------------------------------
    def fill_page(self):
        self.c.setFillColor(CREAM)
        self.c.rect(0, 0, W, H, stroke=0, fill=1)

    def txt(self, x, y, s, font, size, align="l"):
        if self.dry or not s:
            return
        c = self.c
        total = rw(s, font, size)
        if align == "r":
            x -= total
        elif align == "c":
            x -= total / 2
        c.setFillColor(BLACK)
        for t, sp in segs(s):
            if sp:
                c.setFont(font, size * SUP)
                c.drawString(x, y + size * 0.38, t)
                x += pdfmetrics.stringWidth(t, font, size * SUP)
            else:
                c.setFont(font, size)
                c.drawString(x, y, t)
                x += pdfmetrics.stringWidth(t, font, size)

    def rect(self, x, top, w, h, fill=None, stroke=NAVY, lw=0.6, radius=0):
        if self.dry:
            return
        c = self.c
        if fill is not None:
            c.setFillColor(fill)
        if stroke is not None:
            c.setStrokeColor(stroke)
            c.setLineWidth(lw)
        if radius:
            c.roundRect(x, top - h, w, h, radius, stroke=int(stroke is not None), fill=int(fill is not None))
        else:
            c.rect(x, top - h, w, h, stroke=int(stroke is not None), fill=int(fill is not None))

    def line(self, x1, y1, x2, y2, lw=0.4, dash=None):
        if self.dry:
            return
        c = self.c
        c.setStrokeColor(NAVY)
        c.setLineWidth(lw)
        c.setDash(dash or [])
        c.line(x1, y1, x2, y2)
        c.setDash([])

    def link(self, url, x, top, w, h):
        if self.dry or not url:
            return
        self.c.linkURL(url, (x, top - h, x + w, top), relative=0, thickness=0)

    def image(self, im, x, ybot, w, h):
        if self.dry:
            return
        self.c.drawImage(im, x, ybot, w, h, mask=None)

    # -- text blocks --------------------------------------------------------
    def para(self, x, top, w, text, font, size, lead=None, align="l", first_indent=0.0):
        lead = lead or size * 1.25
        lines = wrap(text, font, size, w, first_indent)
        for i, ln in enumerate(lines):
            base = top - i * lead - lead * 0.5 - size * 0.35
            off = first_indent if i == 0 else 0
            if align == "l":
                self.txt(x + off, base, ln, font, size)
            elif align == "c":
                self.txt(x + w / 2, base, ln, font, size, "c")
            else:
                self.txt(x + w, base, ln, font, size, "r")
        return len(lines) * lead


def bar(P, x, top, w, title, s, bump=0.7):
    size = s + bump
    lines = wrap(title, FONT_BOLD, size, w - 8)
    lead = size * 1.2
    h = len(lines) * lead + 6.0
    P.rect(x, top, w, h, fill=GOLD, stroke=NAVY, lw=0.8)
    for i, ln in enumerate(lines):
        P.txt(x + w / 2, top - 3.0 - i * lead - lead / 2 - size * 0.35, ln, FONT_BOLD, size, "c")
    return h


def kv_row(P, x, top, w, label, value, s, lab_frac=0.55, bold_label=True, bold_value=False, pady=2.0):
    lead = s * 1.28
    lf = FONT_BOLD if bold_label else FONT_REG
    vf = FONT_BOLD if bold_value else FONT_REG
    lw_ = min(rw(label, lf, s) + 5, w * lab_frac)      # label column: natural width, capped
    vw = w - lw_ - 3
    ll = wrap(label, lf, s, lw_ - 1)
    vl = wrap(value, vf, s, vw)
    n = max(len(ll), len(vl))
    for i, ln in enumerate(ll):
        P.txt(x, top - pady - i * lead - lead / 2 - s * 0.35, ln, lf, s)
    for i, ln in enumerate(vl):
        P.txt(x + w, top - pady - i * lead - lead / 2 - s * 0.35, ln, vf, s, "r")
    return n * lead + 2 * pady


def text_row(P, x, top, w, text, s, bold=False, indent=0.0, pady=2.0, align="l"):
    f = FONT_BOLD if bold else FONT_REG
    h = P.para(x + indent, top - pady, w - indent, text, f, s, lead=s * 1.28, align=align)
    return h + 2 * pady


