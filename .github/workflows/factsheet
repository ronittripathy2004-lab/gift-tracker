    F.turn_eq, F.turn_gross = S.num("turn.equity", lo=0), S.num("turn.gross", lo=0)

    def level(key, required):
        v = S.txt(key)
        if not v:
            if required:
                err(f"{S.addr(key)} ({key}) riskometer level is required")
            return ""
        for L in RISK_LEVELS:
            if L.lower() == v.lower():
                return L
        err(f"{S.addr(key)} ({key}): '{v}' is not one of {RISK_LEVELS}")
        return ""

    F.rm_scheme, F.rm_prev, F.rm_bm = level("rm.scheme", True), level("rm.scheme_prev", False), level("rm.benchmark", True)

    # performance
    F.perf = []
    for key, default in PERIODS:
        reg = S.num(key, 3, lo=-100, hi=1000)
        if reg is None:
            continue
        lab = S.txt(key, 2) or default
        row = dict(key=key, label=lab, reg=reg, dir=S.num(key, 4, lo=-100, hi=1000),
                   bm=S.num(key, 5, lo=-100, hi=1000), ab=S.num(key, 6, lo=-100, hi=1000))
        yrs = S.num(key, 10)
        if yrs is None and key == "perf.SI" and F.asof and F.inception:
            yrs = (F.asof - F.inception).days / 365
        yrs = yrs if yrs else {"perf.6M": .5, "perf.1Y": 1, "perf.3Y": 3, "perf.5Y": 5, "perf.10Y": 10}.get(key, 1)
        for col, src, dst in [(7, "reg", "v_reg"), (8, "bm", "v_bm"), (9, "ab", "v_ab")]:
            v = S.num(key, col, lo=0)
            if v is None and row[src] is not None:   # cached formula value missing -> same formula in Python
                r = row[src] / 100
                v = round(10000 * (1 + r) if yrs <= 1 else 10000 * (1 + r) ** yrs)
            row[dst] = v
        F.perf.append(row)
    if not F.perf:
        err("No performance row has a Regular return (section 7)")

    # financial-year chart
    F.fy = []
