def _has_rupee(path: Path) -> bool:
    try:
        return 0x20B9 in TTFont("probe", str(path)).face.charToGlyph
    except Exception:
        return False


def register_fonts():
    global RUPEE
    fallback = None
    for d in _FONT_DIRS:
        for r, b in _FONT_PAIRS:
            pr, pb = d / r, d / b
            if not (pr.exists() and pb.exists()):
                continue
            if _has_rupee(pr) and _has_rupee(pb):
                _install(pr, pb)
                print(f"Font : {pr.name} / {pb.name}  ({d})")
                return
            fallback = fallback or (pr, pb)
    if fallback:
        _install(*fallback)
        RUPEE = "Rs."
        warn(f"Font {fallback[0].name} has no rupee glyph; printing 'Rs.' instead. "
             f"Put NotoSans-Regular.ttf and NotoSans-Bold.ttf in {SCRIPT_DIR / 'fonts'} for the \u20b9 sign.")
        return
    sys.exit(f"No usable TrueType font found. Create the folder {SCRIPT_DIR / 'fonts'} and put "
             "NotoSans-Regular.ttf and NotoSans-Bold.ttf (free from Google Fonts) in it.")


def _install(pr: Path, pb: Path):
    pdfmetrics.registerFont(TTFont(FONT_REG, str(pr)))
    pdfmetrics.registerFont(TTFont(FONT_BOLD, str(pb)))
    _GLYPHS.update(pdfmetrics.getFont(FONT_REG).face.charToGlyph.keys())


_MISSING: set[str] = set()


def clean(s: str) -> str:
    s = unicodedata.normalize("NFC", s)
    s = s.replace("\u00a0", " ").replace("\u200b", "").replace("\t", " ")
    s = re.sub(r"[ ]{2,}", " ", s).strip()
    if RUPEE != "\u20b9":
        s = s.replace("\u20b9", RUPEE)
    return s


