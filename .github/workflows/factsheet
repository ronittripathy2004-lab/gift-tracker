def page3(P, F, page_no):
    P.fill_page()
    draw_header(P, F)
    s = 8.4
    y = H - 66
    y -= P.para(MX, y, CW, "Additional Disclosure", FONT_BOLD, 11.5) + 8

    def item(label, text):
        nonlocal y
        if not text:
            return
        lw_ = rw(label + " ", FONT_BOLD, s + 0.6)
        P.txt(MX, y - (s + 0.6) * 1.3 / 2 - (s + 0.6) * 0.35, label, FONT_BOLD, s + 0.6)
        y -= P.para(MX, y, CW, text, FONT_REG, s + 0.6, lead=(s + 0.6) * 1.3, first_indent=lw_) + 5

    item("About the Fund:", F.about)
    item("Category:", F.category)
    item("SIP Frequency:", F.sip_freq)
    item("SIP Dates (Monthly/Quarterly)@@:", F.sip_dates)
    item("Minimum Investment Amount:", F.lumpsum)
    item("Option Available:", F.options)
    y -= 4

    if F.alloc:
        cw_, chh = 300.0, 22.0 + 26.0 * len(F.alloc)
        hb = bar(P, MX, y, cw_, F.alloc_title or "ALLOCATION", s)
        alloc_chart(P, MX, y - hb, cw_, chh, F.alloc)
        P.rect(MX, y, cw_, hb + chh, fill=None, stroke=NAVY, lw=0.8)
        y -= hb + chh + 14

    # performance table (custom: two-level header)
    n = len(F.perf)
    name_w = 132.0
    colw = (CW - name_w) / (2 * n)
    widest = 0
    fs = 7.6
    rows = [(F.name, "reg", "v_reg")]
    rows.append((F.benchmark + "#", "bm", "v_bm"))
    if F.addl:
        rows.append((F.addl + "##", "ab", "v_ab"))
    while fs > 6.0:
        cells = [pct(r_[k]) for r_ in F.perf for _, k, _ in rows] + [indian(r_[v], 0) if r_[v] is not None else "NA"
                                                                       for r_ in F.perf for _, _, v in rows]
        if max(rw(t, FONT_REG, fs) for t in cells) <= colw - 3:
            break
        fs -= 0.2
    lead = fs * 1.22
    labels = []
    for r_ in F.perf:
        lab = r_["label"]
        if r_["key"] == "perf.SI" and F.inception:
            lab = f"Since Inception {d_short(F.inception)}"
        labels.append(lab)
    hs = fs
    words = [w_ for l in labels for w_ in l.split()]
    while hs > 5.5 and max(rw(w_, FONT_BOLD, hs) for w_ in words) > colw - 5:
        hs -= 0.2
    h_title = bar(P, MX, y, CW, "Performance Table", fs)
    t0 = y
    y -= h_title
    h1 = lead + 7
    h2 = max(len(wrap(l, FONT_BOLD, hs, colw - 4)) for l in labels) * hs * 1.22 + 7
    P.rect(MX, y, CW, h1 + h2, fill=None, stroke=NAVY, lw=0.8)
    P.txt(MX + name_w / 2, y - (h1 + h2) / 2 - fs * 0.35, "Scheme Name", FONT_BOLD, fs, "c")
    P.line(MX + name_w, y, MX + name_w, y - h1 - h2, 0.6)
    P.txt(MX + name_w + n * colw / 2, y - h1 / 2 - fs * 0.35, "CAGR Returns (%)", FONT_BOLD, fs, "c")
    P.txt(MX + name_w + 1.5 * n * colw, y - h1 / 2 - fs * 0.35,
          f"Current Value of Investment of {RUPEE}10,000", FONT_BOLD, fs, "c")
    P.line(MX + name_w, y - h1, W - MX, y - h1, 0.6)
    P.line(MX + name_w + n * colw, y, MX + name_w + n * colw, y - h1 - h2, 0.9)
    for blk in (0, 1):
        for i, lab in enumerate(labels):
            cx = MX + name_w + (blk * n + i) * colw
            if i or blk:
                P.line(cx, y - h1, cx, y - h1 - h2, 0.4)
            lines = wrap(lab, FONT_BOLD, hs, colw - 4)
            hl = hs * 1.22
            for j, ln in enumerate(lines):
                P.txt(cx + colw / 2, y - h1 - (h2 - len(lines) * hl) / 2 - j * hl - hl / 2 - hs * 0.35,
                      ln, FONT_BOLD, hs, "c")
    y -= h1 + h2
    P.line(MX, y, W - MX, y, 0.9)
    for nm, k, v in rows:
        nl = wrap(nm, FONT_BOLD, fs, name_w - 6)
        rh = max(len(nl) * lead + 6, lead + 6)
        for j, ln in enumerate(nl):
            P.txt(MX + 3, y - (rh - len(nl) * lead) / 2 - j * lead - lead / 2 - fs * 0.35, ln, FONT_BOLD, fs)
        for i, r_ in enumerate(F.perf):
            cx = MX + name_w + i * colw
            P.txt(cx + colw / 2, y - rh / 2 - fs * 0.35, pct(r_[k]), FONT_REG, fs, "c")
            cx2 = MX + name_w + (n + i) * colw
            P.txt(cx2 + colw / 2, y - rh / 2 - fs * 0.35, indian(r_[v], 0) if r_[v] is not None else "NA",
                  FONT_REG, fs, "c")
        for i in range(1, 2 * n):
            cx = MX + name_w + i * colw
            P.line(cx, y, cx, y - rh, 0.4 if i != n else 0.9)
        P.line(MX + name_w, y, MX + name_w, y - rh, 0.6)
        y -= rh
        P.line(MX, y, W - MX, y, 0.4)
    P.rect(MX, t0, CW, t0 - y, fill=None, stroke=NAVY, lw=0.8)
    y -= 9

    fsz = 7.6
    for t in F.foot:
        y -= P.para(MX, y, CW, t, FONT_REG, fsz, lead=fsz * 1.28) + 3
    if y < BOTTOM:
        warn("Page 3 footnotes run into the footer")
    draw_footer(P, F, page_no)


