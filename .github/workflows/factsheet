        if lab and (r is not None or d_ is not None or b is not None):
            F.fy.append(dict(label=lab, reg=r, dir=d_, bm=b))
    # allocation
    F.alloc_title = S.txt("alloc.title")
    F.alloc = []
    for i in range(1, 7):
        lab, v = S.txt(f"alloc.{i}", 2), S.num(f"alloc.{i}", 3, lo=0, hi=100)
        if lab and v is not None:
            F.alloc.append((lab, v))
    if F.alloc and not (98.5 <= sum(v for _, v in F.alloc) <= 101.5):
        warn(f"Allocation bars add up to {sum(v for _, v in F.alloc):.2f}% (expected about 100%)")
    # holdings
    F.top = []
    for i in range(1, 11):
        nm, v = S.txt(f"top.{i}", 2), S.num(f"top.{i}", 3, lo=0, hi=100)
        if nm and v is not None:
            F.top.append((nm, v))
        elif nm or v is not None:
            err(f"Top holding {i}: name and % must both be filled")
    if not F.top:
        warn("No top-10 holdings filled")
    if sum(v for _, v in F.top) > 100.01:
        err("Top-10 holdings add up to more than 100%")
    F.added, F.reduced = [], []
    for pre, lst in (("add", F.added), ("red", F.reduced)):
        for i in range(1, 11):
            nm, v = S.txt(f"{pre}.{i}", 2), S.num(f"{pre}.{i}", 3, lo=0, hi=100)
            if nm and v is not None:
                lst.append((nm, v))
            elif nm or v is not None:
                err(f"Changes in holdings {pre}.{i}: name and % must both be filled")
    # links & common text
    F.links = [(lab, S.url(key)) for key, lab in [
        ("link.securities", "Detailed Investment in Securities"), ("link.sectors", "Allocation of Net Asset by Sectors"),
        ("link.asset_class", "Allocation of Net Asset by Asset Class"),
        ("link.credit", "Allocation of Net Assets by Credit Rating"),
        ("link.region", "Allocation of Net Assets by region/country")]]
    F.web = [(WEB_NAMES[i - 1], S.txt(f"web.{i}.desc"), S.url(f"web.{i}.url")) for i in range(1, 7)]
    g = lambda k: S.txt(k)
    F.t = {k: g(k) for k in [
        "common.label_intro", "common.label_footer", "common.past_perf", "common.rf.1", "common.rf.2", "common.rf.3",
        "common.rf.4", "common.rf.note", "common.rm.std", "common.rm.info", "common.rm.sharpe", "common.rm.beta",
        "common.fn.detail_page", "common.fn.na"]}
    for k, v in F.t.items():
        if not v and k not in ("common.rf.note", "common.fn.na", "common.fn.detail_page"):
            warn(f"{S.addr(k)} ({k}) is empty")
    F.foot = [S.txt(k) for k in FOOT_ORDER if S.txt(k)]
    F.extra_name_note = S.txt("fund.name_note")
    if F.asof:
        for t in F.foot:
            for m in re.finditer(r"\b(\d{2})/(\d{2})/(\d{4})\b", t):
                try:
                    if dt.date(int(m[3]), int(m[2]), int(m[1])) != F.asof:
                        warn(f"Footnote mentions {m[0]} but the as-of date is {F.asof:%d/%m/%Y}")
                except ValueError:
                    pass

    if S.placeholders:
        warn(f"{len(S.placeholders)} link URL(s) are still placeholders (example.com or '...'): "
             + ", ".join(S.placeholders))
    # images
    bases = [S.name, F.name]
    F.img_scheme = find_image(risk_idx, bases, ["scheme riskometer", "riskometer", "scheme", ""])
    F.img_bm = find_image(risk_idx, bases, ["benchmark riskometer", "benchmark", "bm riskometer", "bm"])
    F.img_qr = find_image(qr_idx, bases, ["qr", "qr code", "qrcode", ""])
    for img, what, folder in [(F.img_scheme, f"{S.name}_scheme_riskometer", RISK_DIR),
                              (F.img_bm, f"{S.name}_benchmark_riskometer", RISK_DIR),
                              (F.img_qr, f"{S.name}_qr", QR_DIR)]:
        if img is None:
            err(f"image not found: '{what}' (.png/.jpg/.jpeg) in {folder}")
    return F


