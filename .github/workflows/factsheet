# =============================================================================
class Sheet:
    def __init__(self, ws):
        self.ws = ws
        self.name = ws.title
        self.placeholders = []
        self.row = {}
        for r in range(1, ws.max_row + 1):
            k = ws.cell(r, 1).value
            if isinstance(k, str) and k.strip() and k.strip() != "key":
                self.row[k.strip()] = r

    def raw(self, key, col=3):
        r = self.row.get(key)
        return None if r is None else self.ws.cell(r, col).value

    def addr(self, key, col=3):
        r = self.row.get(key)
        return f"{get_column_letter(col)}{r}" if r else f"[{key}]"

    def txt(self, key, col=3, required=False):
        v = self.raw(key, col)
        if v is None:
            s = ""
        elif isinstance(v, float) and v.is_integer():
            s = str(int(v))
        elif isinstance(v, (dt.datetime, dt.date)):
            s = v.strftime("%d/%m/%Y")
        else:
            s = str(v)
        s = clean(s)
        if required and not s:
            err(f"{self.addr(key, col)} ({key}) is required but empty")
        return s

    def num(self, key, col=3, required=False, lo=None, hi=None):
        v = self.raw(key, col)
        if v is None or (isinstance(v, str) and not v.strip()):
            if required:
                err(f"{self.addr(key, col)} ({key}) is required but empty")
            return None
        try:
            if isinstance(v, str):
                t = v.strip().replace(",", "").replace("%", "").replace("\u20b9", "").strip()
                if t.upper() in ("NA", "N/A", "-", "\u2013"):
                    return None
                v = float(t)
            v = float(v)
        except (TypeError, ValueError):
            err(f"{self.addr(key, col)} ({key}): '{v}' is not a number")
            return None
        if math.isnan(v):
            return None
        if (lo is not None and v < lo) or (hi is not None and v > hi):
            err(f"{self.addr(key, col)} ({key}): {v} is outside the plausible range {lo}..{hi}")
        return v

    def date(self, key, col=3, required=False):
        v = self.raw(key, col)
        if isinstance(v, dt.datetime):
            return v.date()
        if isinstance(v, dt.date):
            return v
        if isinstance(v, str) and v.strip():
            for f in ("%d/%m/%Y", "%d-%m-%Y", "%Y-%m-%d", "%d %B %Y", "%d %b %Y", "%B %d, %Y"):
                try:
                    return dt.datetime.strptime(v.strip(), f).date()
                except ValueError:
                    pass
            err(f"{self.addr(key, col)} ({key}): '{v}' is not a valid date (use a real Excel date)")
            return None
        if required:
            err(f"{self.addr(key, col)} ({key}) is required but empty")
        return None

    def url(self, key):
        u = self.txt(key)
        if not u:
            return ""
        if not re.match(r"^https?://\S+$", u, re.I):
            err(f"{self.addr(key)} ({key}): '{u}' is not a full URL starting with http(s)://")
            return ""
        if "example.com" in u.lower() or u.endswith("..."):
            self.placeholders.append(self.addr(key))
        return u


