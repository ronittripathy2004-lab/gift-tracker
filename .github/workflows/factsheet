    F.lumpsum = S.txt("min.lumpsum", required=True)
    F.sip = S.txt("min.sip", required=True)
    F.sip_freq = S.txt("min.sip_freq")
    F.sip_dates = S.txt("min.sip_dates")
    F.options = S.txt("min.options")
    F.load = [t for t in (S.txt(f"load.{i}") for i in range(1, 6)) if t]
    F.ter = {"Regular": (S.num("ter.regular", 3, required=True, lo=0, hi=10), S.num("ter.regular", 4, lo=0, hi=10)),
             "Direct": (S.num("ter.direct", 3, lo=0, hi=10), S.num("ter.direct", 4, lo=0, hi=10))}
    F.std, F.beta = S.num("risk.std", lo=0), S.num("risk.beta")
