def left_col(P, F, x, top, w, s):
    PX = 5.0
    iw = w - 2 * PX
    y = [top]

    def add(h):
        y[0] -= h

    def row(label, value, lf=0.55, bl=True, bv=False):
        add(kv_row(P, x + PX, y[0], iw, label, value, s, lf, bl, bv))

    def head(t):
        add(bar(P, x, y[0], w, t, s))

    asof = d_us(F.asof)
    head("Fund Details")
    row("Date of Inception / Allotment", d_long(F.inception), 0.56)
    row("Benchmark:", F.benchmark, 0.30)
    if F.addl:
        row("Additional Benchmark:", F.addl, 0.46)
    add(text_row(P, x + PX, y[0], iw, f"NAV as on {asof}", s, bold=True))
    for lab, v in F.nav:
        row(lab, f"{RUPEE} {f_fixed(v, 4)}", 0.60, bl=False)
    row(f"AUM as on {asof}", f"{RUPEE} {indian(F.aum, 2)} Crores", 0.46)
    row(f"AAUM as on {asof}", f"{RUPEE} {indian(F.aaum, 2)} Crores", 0.46)

    head("Fund Manager Details")
    add(text_row(P, x + PX, y[0], iw, "Name of Fund Managers", s, bold=True))
    for nm, _, _ in F.fms:
        add(text_row(P, x + PX, y[0], iw, "\u2022  " + nm, s, bold=True, pady=1.4))
    row("Total Experience (Years)", " / ".join(num_text(e) for _, e, _ in F.fms), 0.60)
    row("Managing Since", " / ".join(d_long(d) if d else "NA" for _, _, d in F.fms), 0.34)

    head("Minimum Investment")
    row("Lumpsum Amount", F.lumpsum, 0.36, bl=False)
    row("SIP Amount", F.sip, 0.36, bl=False)

    head("Load Structure")
    prev = ""
    for ln in F.load:
        sub = False
        t = ln
        if t.startswith(">"):
            sub, t = True, t[1:].strip()
        elif t.startswith("\u2022"):
            t = t[1:].strip()
        elif prev.rstrip().endswith((":", ",")):
            sub = True
        if sub:
            add(text_row(P, x + PX, y[0], iw, t, s, indent=11, pady=1.0))
        else:
            hh = P.para(x + PX + 9, y[0] - 1.6, iw - 9, t, FONT_REG, s, lead=s * 1.28)
            P.txt(x + PX + 1.5, y[0] - 1.6 - s * 1.28 / 2 - s * 0.35, "\u2022", FONT_REG, s)
            add(hh + 3.2)
        prev = ln
    add(2.0)

    head("Expense Ratio")
    for k in ("Regular", "Direct"):
        v = F.ter[k][0]
        row(f"{k} Plan: BER", pct(v), 0.62)

    head("Risk Measures")
    for i, (lab, v) in enumerate([("Standard Deviation (%)", F.std), ("Beta", F.beta),
                                  ("Sharpe Ratio", F.sharpe), ("Information Ratio", F.info)], 1):
        P.txt(x + PX, y[0] - 2 - s * 1.28 / 2 - s * 0.35, str(i), FONT_REG, s)
        add(kv_row(P, x + PX + 9, y[0], iw - 9, lab, plain(v), s, 0.78, False))
    add(text_row(P, x + PX, y[0], iw, F.t["common.fn.detail_page"], s - 0.3, bold=True))
    add(text_row(P, x + PX, y[0], iw, F.t["common.fn.na"] or "NA stands for \u201cNot Applicable\u201d", s - 0.3, bold=True))
    h = top - y[0]
    P.rect(x, top, w, h, fill=None, stroke=NAVY, lw=0.8)
    return h


def mid_col(P, F, x, top, w, s, ch):
    y = top
    rows = [[r["label"], pct(r["reg"]), pct(r["dir"]), pct(r["bm"])] for r in F.perf]
    cw0 = 62.0
    rest = (w - cw0) / 3
    y -= table(P, x, y, [cw0, rest, rest, rest],
               [["Compounded Annualised Returns", "Scheme Returns (%) - Regular", "Scheme Returns (%) - Direct",
                 "Benchmark Returns (%)"]], rows, s, ["l", "c", "c", "c"], title="Fund Performance")
    note = f"Performance as on {d_us(F.asof)}. Returns for periods up to 1 year are absolute; beyond 1 year they are compounded annualised (CAGR)."
    y -= P.para(x, y - 2, w, note, FONT_REG, s - 0.5, lead=(s - 0.5) * 1.25) + 8

    if F.fy:
        t0 = y
        hb = bar(P, x, y, w, "Absolute Returns", s)
        fy_chart(P, x, y - hb, w, ch, F.fy)
        cap = f"Absolute Returns for each F.Y. for last {len(F.fy)} year{'s' if len(F.fy) > 1 else ''}."
        capy = y - hb - ch
        hcap = P.para(x + 4, capy, w - 8, cap, FONT_REG, s - 0.5, lead=(s - 0.5) * 1.25) + 3
        y = capy - hcap
        P.rect(x, t0, w, t0 - y, fill=None, stroke=NAVY, lw=0.8)
        y -= 8

    rows = [[str(i), nm, pct(v)] for i, (nm, v) in enumerate(F.top, 1)]
    y -= table(P, x, y, [17, w - 17 - 52, 52],
               [[Cell(""), "Top 10 Holdings", "% of Net Assets"]], rows, s, ["c", "l", "c"], title="Portfolio Data")
    return top - y


def risk_panel(P, F, x, top, w, s, ih, which):
    scheme = which == "scheme"
    title = "Scheme Riskometer" if scheme else "Benchmark Riskometer"
    img = F.img_scheme if scheme else F.img_bm
    level = (F.rm_scheme if scheme else F.rm_bm).lower()
    y = top
    y -= bar(P, x, y, w, title, s)
    y -= 3
    if RISKOMETER_CAPTIONS:
        y -= P.para(x + 3, y, w - 6, F.name if scheme else F.benchmark, FONT_REG, s - 0.4, align="c") + 1
    bw = w - 8
    if img is not None and not P.dry:
        im, asp = prepare_image(img, bw, ih, "art")
        dw, dh = (ih * asp, ih) if ih * asp <= bw else (bw, bw / asp)
        P.image(im, x + (w - dw) / 2, y - ih + (ih - dh) / 2, dw, dh)
    y -= ih
    if RISKOMETER_CAPTIONS:
        y -= P.para(x + 3, y - 1, w - 6, f"This risk of the {'scheme' if scheme else 'benchmark'} is {level}.",
                    FONT_BOLD, s - 0.6, align="c") + 1
    y -= 3
    P.rect(x, top, w, top - y, fill=None, stroke=NAVY, lw=0.8)
    return top - y


def right_col(P, F, x, top, w, s, ih):
    y = top
    y -= risk_panel(P, F, x, y, w, s, ih, "scheme") + 6
    y -= risk_panel(P, F, x, y, w, s, ih, "benchmark") + 6
    rf = [[str(i), F.t[f"common.rf.{i}"]] for i in range(1, 5) if F.t.get(f"common.rf.{i}")]
    y -= table(P, x, y, [15, w - 15], [], rf, s - 0.2, ["c", "l"], title="Major Risk Factors")
    if F.t["common.rf.note"]:
        y -= P.para(x + 1, y - 2, w - 2, F.t["common.rf.note"], FONT_REG, s - 0.5, lead=(s - 0.5) * 1.25) + 7
    else:
        y -= 6
    q = [["1", Cell("Portfolio Turnover Ratio (Annualized)^", span=2)],
         ["", "a) Equity Turnover", plain(F.turn_eq)],
         ["", "b) Gross Exposure Turnover", plain(F.turn_gross)],
         ["", Cell("(Equity + Debt + Derivatives)", span=2)]]
    y -= table(P, x, y, [15, w - 15 - 28, 28], [], q, s - 0.2, ["c", "l", "c"],
               title="Quantitative Measures/Risk Measures* (as applicable)")
    y -= P.para(x + 1, y - 2, w - 2, F.t["common.fn.detail_page"], FONT_BOLD, s - 0.5, lead=(s - 0.5) * 1.25) + 3
    y -= P.para(x + 1, y - 1, w - 2, F.t["common.fn.na"] or "NA stands for \u201cNot Applicable\u201d",
                FONT_BOLD, s - 0.5, lead=(s - 0.5) * 1.25) + 2
    return top - y


def addl_panel(P, F, x, top, w, s):
    y = top
    y -= bar(P, x, y, w, "Additional Information pertaining to Portfolio of the scheme", s)
    rh = s * 2.5
    bw = 66.0
    for lab, url in F.links:
        P.txt(x + 5, y - rh / 2 - s * 0.35, lab, FONT_BOLD, s + 0.3)
        if url:
            bx = x + w - bw - 14
            P.rect(bx, y - 2.5, bw, rh - 5, fill=GOLD, stroke=NAVY, lw=0.8, radius=4)
            P.txt(bx + bw / 2, y - rh / 2 - s * 0.35, "Click here", FONT_BOLD, s, "c")
            P.link(url, bx, y - 2.5, bw, rh - 5)
        P.line(x, y - rh, x + w, y - rh, 0.3)
        y -= rh
    P.rect(x, top, w, top - y, fill=None, stroke=NAVY, lw=0.8)
    return top - y


def page1(P, F, page_no):
    P.fill_page()
    draw_header(P, F, title=True)
    y = H - 66
    lab_w = max(rw("Type of Scheme:", FONT_BOLD, 9.5), rw("Product labelling:", FONT_BOLD, 9.5)) + 8
    P.txt(MX, y - 8.5, "Type of Scheme:", FONT_BOLD, 9.5)
    y -= P.para(MX + lab_w, y, CW - lab_w, F.type, FONT_REG, 9.5, lead=12.4) + 5
    P.txt(MX, y - 8.5, "Product labelling:", FONT_BOLD, 9.5)
    tw_ = CW - lab_w - 118
    y -= P.para(MX + lab_w, y, tw_, F.t["common.label_intro"], FONT_REG, 9.5, lead=12.4)
    for b in F.labels:
        hb = P.para(MX + lab_w + 18, y, tw_ - 18, b, FONT_REG, 9.5, lead=12.4)
        P.txt(MX + lab_w + 6, y - 12.4 / 2 - 9.5 * 0.35, "\u2022", FONT_REG, 9.5)
        y -= hb
    y -= P.para(MX + lab_w, y, tw_, F.t["common.label_footer"], FONT_REG, 9.5, lead=12.4)
    P.txt(W - MX, y + 4, F.month, FONT_BOLD, 13.5, "r")
    col_top = y - 8

    LW_, MW_ = 172.0, 215.0
    RW_ = CW - LW_ - MW_ - 16
    xL, xM, xR = MX, MX + LW_ + 8, MX + LW_ + MW_ + 16
    chosen = None
    for k in range(0, 41):
        s, ch, ih = 8.0 - 0.1 * k, max(96.0, 150.0 - 3 * k), max(58.0, 92.0 - 2 * k)
        P.dry = True
        hL = left_col(P, F, xL, 0, LW_, s)
        hM = mid_col(P, F, xM, 0, MW_, s, ch)
        hR = right_col(P, F, xR, 0, RW_, s, ih)
        hA = addl_panel(P, F, xM, 0, MW_ + 8 + RW_, s)
        P.dry = False
        okL = hL <= col_top - BOTTOM
        okMR = max(hM, hR) <= col_top - BOTTOM - hA - 8
        chosen = (s, ch, ih, hA)
        if okL and okMR:
            break
    else:
        warn(f"Page 1 content does not fit even at the smallest font size ({s:.1f}pt): shorten text")
    s, ch, ih, hA = chosen
    P.dry = True
    spare_m = (col_top - BOTTOM - hA - 8) - mid_col(P, F, xM, 0, MW_, s, ch)
    spare_r = (col_top - BOTTOM - hA - 8) - right_col(P, F, xR, 0, RW_, s, ih)
    P.dry = False
    ch += max(0.0, min(spare_m - 4, 60.0))
    ih += max(0.0, min((spare_r - 4) / 2, 100.0 - ih))
    left_col(P, F, xL, col_top, LW_, s)
    mid_col(P, F, xM, col_top, MW_, s, ch)
    right_col(P, F, xR, col_top, RW_, s, ih)
    addl_panel(P, F, xM, BOTTOM + hA, MW_ + 8 + RW_, s)
    draw_footer(P, F, page_no)


