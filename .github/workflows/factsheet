_IMG_CACHE: dict = {}


def prepare_image(path: Path, box_w, box_h, kind="art"):
    key = (str(path), round(box_w), round(box_h), kind)
    if key in _IMG_CACHE:
        return _IMG_CACHE[key]
    im = Image.open(path)
    im = ImageOps.exif_transpose(im)
    if im.mode in ("RGBA", "LA") or (im.mode == "P" and "transparency" in im.info):
        im = im.convert("RGBA")
        bg = Image.new("RGBA", im.size, (255, 255, 255, 255))
        im = Image.alpha_composite(bg, im)
    im = im.convert("RGB")
    if BLEND_IMAGES_TO_CREAM:
        im = ImageChops.multiply(im, Image.new("RGB", im.size, CREAM_RGB))
    if kind == "qr":
        if min(im.size) < 600:
            f = math.ceil(600 / min(im.size))
            im = im.resize((im.width * f, im.height * f), Image.NEAREST)
    else:
        tw, th = box_w / 72 * 300, box_h / 72 * 300
        sc = min(tw / im.width, th / im.height)
        if sc < 0.67:
            im = im.resize((max(1, int(im.width * sc)), max(1, int(im.height * sc))), Image.LANCZOS)
    res = (ImageReader(im), im.width / im.height)
    _IMG_CACHE[key] = res
    return res


def _norm(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", unicodedata.normalize("NFC", s).lower()).strip()


def index_dir(d: Path) -> dict[str, Path]:
    idx: dict[str, Path] = {}
    if not d.is_dir():
        return idx
    for p in sorted(d.iterdir()):
        if p.suffix.lower() in (".png", ".jpg", ".jpeg") and not p.name.startswith("."):
            idx.setdefault(_norm(p.stem), p)
    return idx


def find_image(idx, bases, suffixes):
    for b in bases:
        if not b:
            continue
        for suf in suffixes:
            k = _norm(f"{b} {suf}")
            if k in idx:
                return idx[k]
    return None


