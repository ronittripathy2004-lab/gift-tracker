MONTHS = ["January", "February", "March", "April", "May", "June", "July",
          "August", "September", "October", "November", "December"]


def f_fixed(x, d):
    q = Decimal(1).scaleb(-d)
    r = Decimal(repr(float(x))).quantize(q, ROUND_HALF_UP)
    if r == 0:
        r = abs(r)
    return f"{r:.{d}f}"


def indian(x, d=0):
    s = f_fixed(x, d)
    neg = s.startswith("-")
    s = s.lstrip("-")
    ip, _, fp = s.partition(".")
    if len(ip) > 3:
        head, tail = ip[:-3], ip[-3:]
        parts = []
        while len(head) > 2:
            parts.insert(0, head[-2:])
            head = head[:-2]
        if head:
            parts.insert(0, head)
        ip = ",".join(parts + [tail])
    return ("-" if neg else "") + ip + ("." + fp if fp else "")


def pct(x, d=2):
    return "NA" if x is None else f_fixed(x, d) + "%"


def plain(x, d=2):
    return "NA" if x is None else f_fixed(x, d)


def d_long(d):      # 09 August 2005
    return f"{d.day:02d} {MONTHS[d.month - 1]} {d.year}"


def d_us(d):        # September 30, 2026
    return f"{MONTHS[d.month - 1]} {d.day:02d}, {d.year}"


def d_short(d):     # Aug 09, 2005
    return f"{MONTHS[d.month - 1][:3]} {d.day:02d}, {d.year}"


def num_text(x):
