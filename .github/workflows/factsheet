def nice_ticks(vmin, vmax, target=5):
    vmin, vmax = min(vmin, 0.0), max(vmax, 0.0)
    if vmax == vmin:
        vmax = vmin + 1
    raw = (vmax - vmin) / target
    mag = 10 ** math.floor(math.log10(raw))
    step = next(m * mag for m in (1, 2, 2.5, 5, 10) if m * mag >= raw)
    lo, hi = math.floor(vmin / step + 1e-9) * step, math.ceil(vmax / step - 1e-9) * step
    n = int(round((hi - lo) / step))
    return lo, hi, step, [lo + i * step for i in range(n + 1)]


def fy_chart(P, x, top, w, h, rows):
    series = [("Regular", "reg", GOLD), ("Direct", "dir", NAVY), ("Benchmark", "bm", CREAM)]
    series = [s_ for s_ in series if any(r[s_[1]] is not None for r in rows)]
    vals = [r[k] for r in rows for _, k, _ in series if r[k] is not None]
    if not vals:
        return
    span = max(max(vals), 0) - min(min(vals), 0) or 1
    lo, hi, step, ticks = nice_ticks(min(vals) - (0.13 * span if min(vals) < 0 else 0), max(vals) + 0.15 * span)
    px0, px1 = x + 27, x + w - 6
    pt, pb = top - 7, top - h + 30
    yv = lambda v: pb + (v - lo) / (hi - lo) * (pt - pb)
    dec = 0 if step >= 1 and float(step).is_integer() else 1
    for t in ticks:
        P.line(px0, yv(t), px1, yv(t), 0.25, [1.5, 1.5])
        P.txt(px0 - 3, yv(t) - 2.0, f"{t:.{dec}f}", FONT_REG, 6, "r")
    gw = (px1 - px0) / len(rows)
    k = len(series)
    bw = min(11.0, gw * 0.84 / k)
    for gi, r in enumerate(rows):
        gx = px0 + gi * gw + (gw - bw * k) / 2
        for si, (nm, key, col) in enumerate(series):
            v = r[key]
            if v is None:
                continue
            bx = gx + si * bw
            y0, y1 = yv(0), yv(v)
            P.rect(bx, max(y0, y1), bw, abs(y1 - y0), fill=col, stroke=NAVY, lw=0.5 if col != CREAM else 0.8)
            if not P.dry:
                c = P.c
                c.saveState()
                c.setFillColor(BLACK)
                c.setFont(FONT_REG, 5.6)
                c.translate(bx + bw / 2 + 2.0, (y1 + 2) if v >= 0 else (y1 - 2))
                c.rotate(90)
                (c.drawString if v >= 0 else c.drawRightString)(0, 0, f_fixed(v, 2))
                c.restoreState()
        P.txt(px0 + gi * gw + gw / 2, pb - 9, r["label"], FONT_REG, 6.2, "c")
    P.line(px0, yv(0), px1, yv(0), 0.8)
    P.line(px0, pb, px0, pt, 0.8)
    # legend
    lw_ = sum(10 + pdfmetrics.stringWidth(n_, FONT_REG, 6.5) + 10 for n_, _, _ in series) - 10
    lx, ly = x + (w - lw_) / 2, top - h + 9
    for nm, key, col in series:
        P.rect(lx, ly + 3, 6, 6, fill=col, stroke=NAVY, lw=0.6)
        P.txt(lx + 9, ly, nm, FONT_REG, 6.5)
        lx += 10 + pdfmetrics.stringWidth(nm, FONT_REG, 6.5) + 10


def alloc_chart(P, x, top, w, h, rows):
    vmax = max(v for _, v in rows)
    _, hi, step, ticks = nice_ticks(0, vmax, 4)
    lab_w = max(rw(l, FONT_REG, 7.5) for l, _ in rows) + 8
    px0, px1 = x + lab_w, x + w - 38
    pt, pb = top - 6, top - h + 16
    slot = (pt - pb) / len(rows)
    bh = min(14.0, slot * 0.62)
    for t in ticks:
        xx = px0 + t / hi * (px1 - px0)
        P.line(xx, pb, xx, pb - 2.5, 0.6)
        P.txt(xx, pb - 10, f"{t:g}%", FONT_REG, 6.5, "c")
    for i, (lab, v) in enumerate(rows):
        cy = pt - slot * (i + 0.5)
        bwid = v / hi * (px1 - px0)
        P.rect(px0, cy + bh / 2, bwid, bh, fill=GOLD, stroke=NAVY, lw=0.5)
        P.txt(px0 - 4, cy - 2.6, lab, FONT_REG, 7.5, "r")
        P.txt(px0 + bwid + 3, cy - 2.6, pct(v), FONT_REG, 7.5)
    P.line(px0, pb, px0, pt, 0.8)
    P.line(px0, pb, px1, pb, 0.8)


